<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="440.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ifba.saj.ads.poo.presentation.ReservaController">
   <children>
      <Label text="Hóspede:">
         <VBox.margin>
            <Insets left="20.0" />
         </VBox.margin></Label>
      <ComboBox fx:id="comboHospede" prefWidth="150.0">
         <VBox.margin>
            <Insets left="20.0" />
         </VBox.margin></ComboBox>
      <Label text="Quarto:">
         <VBox.margin>
            <Insets left="20.0" />
         </VBox.margin></Label>
      <ComboBox fx:id="comboQuarto" prefWidth="150.0">
         <VBox.margin>
            <Insets left="20.0" />
         </VBox.margin></ComboBox>
      <Label text="Check-In:">
         <VBox.margin>
            <Insets left="20.0" />
         </VBox.margin></Label>
      <DatePicker fx:id="dataCheckin">
         <VBox.margin>
            <Insets left="20.0" />
         </VBox.margin></DatePicker>
      <Label text="Check-Out:">
         <VBox.margin>
            <Insets left="20.0" />
         </VBox.margin></Label>
      <DatePicker fx:id="dataCheckout">
         <VBox.margin>
            <Insets left="20.0" />
         </VBox.margin></DatePicker>
      <HBox spacing="10.0">
         <VBox.margin>
            <Insets left="20.0" top="10.0" />
         </VBox.margin>
         <children>
            <Button fx:id="botaoReservar" mnemonicParsing="false" onAction="#reservar" text="Reserva" />
            <Button fx:id="botaoEditar" mnemonicParsing="false" onAction="#editar" text="Salvar edição" />
            <Button fx:id="botaoExcluir" mnemonicParsing="false" onAction="#excluir" text="Excluir" />
         </children>
      </HBox>
      <TableView fx:id="tabelaReservas" prefHeight="200.0" prefWidth="600.0">
         <VBox.margin>
            <Insets left="20.0" top="10.0" />
         </VBox.margin>
         <columns>
            <TableColumn fx:id="colunaHospede" prefWidth="130.0" text="Hóspede" />
            <TableColumn fx:id="colunaQuarto" prefWidth="130.0" text="Quarto" />
            <TableColumn fx:id="colunaCheckin" prefWidth="130.0" text="Checkin" />
            <TableColumn fx:id="colunaCheckout" prefWidth="130.0" text="Checkout" />
         </columns>
      </TableView>
   </children>
</VBox>