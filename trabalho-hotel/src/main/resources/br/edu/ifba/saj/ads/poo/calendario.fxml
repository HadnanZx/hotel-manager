<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.edu.ifba.saj.ads.poo.presentation.CalendarioController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <children>
        <Label text="Escolha o quarto:" />
        <ComboBox fx:id="comboQuarto" prefWidth="200.0" />
        <GridPane fx:id="gridCalendario" hgap="5.0" vgap="5.0" />
    </children>
</VBox>